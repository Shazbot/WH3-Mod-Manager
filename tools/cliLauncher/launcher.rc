#pragma code_page(65001)
#include <winres.h>

#define WHMM_STR2(x) #x
#define WHMM_STR(x) WHMM_STR2(x)

VS_VERSION_INFO VERSIONINFO
 FILEVERSION WHMM_VERSION_MAJOR,WHMM_VERSION_MINOR,WHMM_VERSION_PATCH,0
 PRODUCTVERSION WHMM_VERSION_MAJOR,WHMM_VERSION_MINOR,WHMM_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Tibor Ilić"
            VALUE "FileDescription", "WH3 Mod Manager CLI launcher"
            VALUE "FileVersion", WHMM_STR(WHMM_VERSION_STRING)
            VALUE "InternalName", "whmm-cli"
            VALUE "LegalCopyright", "Copyright (c) Tibor Ilić"
            VALUE "OriginalFilename", "whmm-cli.exe"
            VALUE "ProductName", "WH3 Mod Manager"
            VALUE "ProductVersion", WHMM_STR(WHMM_VERSION_STRING)
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
