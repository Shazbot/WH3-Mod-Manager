{
  "compilerOptions": {
    "allowJs": true,
    "module": "commonjs",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "sourceMap": true,
    "target": "es2021",
    "lib": ["dom", "dom.iterable", "es2023"],
    "baseUrl": ".",
    "outDir": "dist",
    "moduleResolution": "node",
    "strict": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": ["./*"],
      "flowbite-react/store": ["node_modules/flowbite-react/dist/store/index.d.cts"],
      "flowbite-react/helpers/resolve-theme": ["node_modules/flowbite-react/dist/helpers/resolve-theme.d.cts"],
      "@modelcontextprotocol/server": ["node_modules/@modelcontextprotocol/server/dist/index.d.cts"],
      "@modelcontextprotocol/server/stdio": ["node_modules/@modelcontextprotocol/server/dist/stdio.d.cts"],
      "*": ["node_modules/*"]
    },
    "jsx": "react-jsx"
    // "typeRoots": ["node_modules/@types", "./src"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/flowbite/components/Modal/**/*"],
  "files": ["src/index.d.ts"]
}
