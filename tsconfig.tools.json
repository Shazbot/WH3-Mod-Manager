{
  "compilerOptions": {
    "allowJs": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2021",
    "lib": ["es2023"],
    "types": ["node"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/automation/**/*.ts",
    "src/cli/**/*.ts",
    "src/packCore/**/*.ts",
    "src/packFileTypes.ts",
    "src/schema.ts",
    "src/supportedGames.ts",
    "src/loadOrderRules.ts",
    "src/utility/packFileHelpers.ts",
    "src/utility/packFileIndex.ts",
    "src/utility/packFilePathUtils.ts",
    "src/utility/packFileViewing.ts",
    "src/utility/loadOrderRulesFile.ts",
    "src/globalSearch/matcher.ts",
    "src/globalSearch/textScan.ts",
    "src/globalSearch/types.ts"
  ]
}
